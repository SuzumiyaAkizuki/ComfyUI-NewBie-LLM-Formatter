9","steps"],["119","sampler_name"],["119","scheduler"],["119","denoise"],["222","resize_type.scale"]],"cnr_id":"comfy-core","ver":"0.5.1","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.5.2"}},"widgets_values":[]},{"id":10,"type":"ShowText|pysssss","pos":[1820,110],"size":[530,250],"flags":{},"order":13,"mode":0,"inputs":[{"label":"文本","localized_name":"文本","name":"text","type":"STRING","link":5}],"outputs":[{"label":"字符串","localized_name":"字符串","name":"STRING","shape":6,"type":"STRING","links":null}],"title":"展示文本","properties":{"cnr_id":"comfyui-custom-scripts","ver":"f2838ed5e59de4d73cde5c98354b87a8d3200190","Node name for S&R":"ShowText|pysssss","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.5.2"}},"widgets_values":["- **情境因果设计**：核心画面定格在「跃起拔剑 + 魔法蓄力」的最高张力瞬间。持剑手向前冲刺产生光粒子拖尾（可见后果），另一手魔法阵成形（第二可见后果），两个光源共同为脸部和护甲打出轮廓光，构成完整因果链。\n\n- **画师选择**：`@machigami_yoh` 以高饱和度抽象色彩、动感构图和过膝靴少女著称（三维命中：colorful + miniskirt + thigh boots）；`@9ml` 擅长异色瞳短裙战术少女（两维命中：miniskirt + heterochromia），两者叠加强化「夸张色彩 × 战斗少女」的 mika pikazo 精神气质。mika pikazo 本人在 Danbooru 中未找到对应画师标签，以风格最接近的两位替代。\n\n- **发型与瞳色**：`twintails` + `long hair` 构建高马尾/双马尾的活泼感；`heterochromia` + `multicolored hair` + `bright pupils` 实现明亮异色瞳与双色发的视觉冲击，符合日式西幻角色设计惯例。\n\n- **服装与护具层**：`miniskirt` 短裙，`thigh boots` 过膝靴，`half gloves` 半指手套，`bracer` 护腕，`greaves` 护胫，`thigh armor` 大腿甲，`short sword` 腰间短剑——完整还原用户要求的冒险家装备层级。\n\n- **动作与动势**：`jumping` + `charging forward` + `dynamic pose` 定义跃起冲刺的核心动态；`holding sword` 锁定持剑手；`hair floating upwards` + `wind lift` 确保发丝与裙摆飞扬；`motion lines` 为画面注入漫画式速度感。\n\n- **魔法与光效**：`magic` + `light particles` + `glowing` + `magic circle` 构建蓄力时的魔法视觉层；`chiaroscuro` + `contrast` 实现强烈明暗对比，`colorful` 锁定高饱和色调。\n\n- **构图对抗漂移**：空间叙事层首句明确 `(close-up:3)` 并在标签层同时加权，防止自然语言描述废墟环境时模型拉远镜头。`from below` 低角度仰拍进一步强化跃起的压迫感与动感。\n\n- **八维自查结果**：✅ 互动（人物与魔法粒子/光源互动）✅ 情感（自信笑容+异色瞳映光）✅ 视线（confident smile 暗示看向前方/画外目标）✅ 联动（冲刺气流扬起发丝裙摆）✅ 动势（跃起失衡、motion lines、重心前倾）✅ 空间（前景人物+背景虚化废墟景深）✅ 质感（金属护甲轮廓光 + 魔法粒子发光）✅ 因果（冲刺→跃起→蓄力→粒子喷涌→笑容）——八维全部触发。\n\n- **空间叙事层翻译**：「以低角度荷式仰拍的近景构图，少女从古代石质废墟上腾空跃起，占据画面中心——持剑的手向前冲出，拖曳着发光的魔法粒子；另一只手正在凝聚成形的魔法阵，两处光源在她咧嘴大笑的脸和分层护甲上投下锐利的轮廓光。背景废墟化为柔焦散景，饱和的暖琥珀与冷紫罗兰色形成强烈对比，动态线条从她身体向外放射，放大爆炸性的前冲动势。」"]},{"id":2,"type":"AnimaLatentImage","pos":[1550,790],"size":[212.3638671875,184],"flags":{},"order":3,"mode":0,"inputs":[{"localized_name":"preset","name":"preset","type":"COMBO","widget":{"name":"preset"},"link":null},{"localized_name":"width","name":"width","type":"INT","widget":{"name":"width"},"link":null},{"localized_name":"height","name":"height","type":"INT","widget":{"name":"height"},"link":null},{"localized_name":"batch_size","name":"batch_size","type":"INT","widget":{"name":"batch_size"},"link":null}],"outputs":[{"localized_name":"latent","name":"latent","type":"LATENT","links":[3]},{"localized_name":"width","name":"width","type":"INT","links":null},{"localized_name":"height","name":"height","type":"INT","links":null}],"properties":{"Node name for S&R":"AnimaLatentImage","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.5.2"}},"widgets_values":["720×1280 (9:16 HD)",720,1280,1],"color":"#0f0f0eff","bgcolor":"#0f0f0eff","boxcolor":"rgba(212, 175, 55, 0.6)"},{"id":9,"type":"ShowText|pysssss","pos":[1820,-160],"size":[530,230],"flags":{},"order":12,"mode":0,"inputs":[{"label":"文本","localized_name":"文本","name":"text","type":"STRING","link":4}],"outputs":[{"label":"字符串","localized_name":"字符串","name":"STRING","shape":6,"type":"STRING","links":[6]}],"title":"展示文本","properties":{"cnr_id":"comfyui-custom-scripts","ver":"f2838ed5e59de4d73cde5c98354b87a8d3200190","Node name for S&R":"ShowText|pysssss","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.5.2"}},"widgets_values":["masterpiece, best quality, very aesthetic, score_7, safe, newest, year 2025, @machigami_yoh, @9ml,\n\n1girl, solo, long hair, twintails, heterochromia, multicolored_hair, two-tone hair, bright pupils, sm